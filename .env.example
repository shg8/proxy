# Credentials clients use to authenticate to the proxy.
PROXY_USER=changeme
PROXY_PASS=changeme

# Host interface to listen on. 0.0.0.0 = all interfaces.
PROXY_BIND=0.0.0.0
PROXY_PORT=3128

# Max simultaneous connections.
PROXY_MAXCONN=200

# --- native systemd install only (install.sh) ---
# Separate port so the systemd service can run alongside the Docker stack.
NATIVE_PORT=3129
# Ports CONNECT tunnelling is allowed to reach.
NATIVE_CONNECT_PORTS=443 563
